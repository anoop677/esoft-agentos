# Local development only. Replace all example values before shared or production use.
POSTGRES_PASSWORD=agentos_dev_only
AGENTOS_APP_PASSWORD=agentos_app_dev_only

# Keep false for local development. Production deployments must enable Keycloak auth.
AUTH_ENABLED=false
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=agentos-api
KEYCLOAK_JWKS_URL=

# Optional: required to execute OpenAI-backed agent runs
OPENAI_API_KEY=

# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this key outside source control and back it up securely. Losing it makes stored credentials unrecoverable.
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY_VERSION=v1

# Comma-separated exact ERPNext hostnames approved by platform operations.
# No wildcard domains. Keep this list aligned with outbound network egress rules.
CONNECTOR_ALLOWED_HOSTS=
